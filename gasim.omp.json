{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .SSHSession }} \ueba9  {{ end }}",
          "foreground": "black",
          "background": "blue",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "type": "nix-shell",
          "style": "powerline",
          "foreground": "white",
          "background": "#5277C3",
          "template": "{{ if and .Type (ne .Type \"unknown\") }} \uf0c3 {{ end }}"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uf0e7 ",
          "foreground": "black",
          "background": "#ffa500",
          "type": "root"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\u0000",
          "foreground": "black",
          "background": "black",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "home_icon": "~",
            "mapped_locations": {
              "/": "\u0000"
            },
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "template": "{{if .RootDir}}/{{else}}{{ .Path }}{{end}} ",
          "foreground": "white",
          "powerline_symbol": "\ue0b0",
          "background": "black",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\uf126 ",
            "cache_duration": "none",
            "fetch_stash_count": false,
            "fetch_status": true
          },
          "template": " {{ .HEAD }} {{ if .Working.Changed }}\uf044{{ end }}{{ if .Staging.Changed }} \uf046 {{ end }}{{ if gt .WorktreeCount 0}} \uf1bb {{ end }} ",
          "foreground": "black",
          "powerline_symbol": "\ue0b0",
          "background": "lightGreen",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}yellow{{ end }}"
          ]
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
